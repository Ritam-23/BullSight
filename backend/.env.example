# Copy to backend/.env and fill in.

# Where the Next.js frontend runs. OAuth callbacks go to {FRONTEND_URL}/api/auth/callback/{provider}
FRONTEND_URL=http://localhost:3000

# Long random string used to sign session cookies (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=

# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# auto = demo login shown only while no OAuth provider is configured; true/false to force.
ALLOW_DEMO_LOGIN=auto

# Stripe TEST keys for adding virtual money to the paper-trading wallet (sk_test_... / pk_test_...).
# Live keys are refused: real stock trading needs a SEBI-registered broker API, not a payment gateway.
# Without keys, the wallet offers "Add virtual funds" instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional webhook signing secret (from `stripe listen --forward-to localhost:8000/api/wallet/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=
