# Copy to .env for `docker compose up`. Everything here is optional for a basic run
# (email/password + demo login work with just SESSION_SECRET).

# Sign sessions. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-secret-change-me

# Keep the demo login button on locally.
ALLOW_DEMO_LOGIN=true

# --- SMTP: purchase-receipt email (nodemailer). Leave blank to disable. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BullSight <you@example.com>

# --- Optional OAuth (needs a public https URL + registered redirect to actually work) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
