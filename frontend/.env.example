# Copy to frontend/.env.local and fill in. These are read server-side (Next.js route handler),
# so they are NOT prefixed with NEXT_PUBLIC and never reach the browser.

# Where the FastAPI backend runs (the /receipt route fetches purchase data from it).
BACKEND_URL=http://127.0.0.1:8000

# SMTP for sending the purchase-receipt email via nodemailer. Leave blank to disable emailing
# (login still works normally; the receipt step just no-ops).
#
# Gmail example: host smtp.gmail.com, port 587, user = your address, pass = a 16-char
# App Password (https://myaccount.google.com/apppasswords — needs 2-Step Verification on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From header shown in the inbox. Use an address on the SAME domain as SMTP_USER so SPF/DKIM
# align — this is what keeps the mail out of spam. Defaults to "BullSight <SMTP_USER>".
SMTP_FROM=BullSight <your@address.com>

# --- Deliverability (avoiding spam) ---
# Real inbox placement depends on the SENDING DOMAIN's DNS, which can't be set from code:
#   1. Use a domain you control (or Gmail, which is pre-authenticated).
#   2. Publish an SPF record authorizing your SMTP provider.
#   3. Enable DKIM signing with your provider and publish the DKIM key.
#   4. Add a DMARC record.
# A reputable transactional provider (SendGrid, Mailgun, Amazon SES, Postmark) sets most of
# this up for you and has far better inbox rates than a raw self-hosted SMTP server.
